{
  "name": "@di/coding-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Di Node host composition root (TypeScript Core migration; compilable stub until later phases)",
  "engines": {
    "node": ">=22.19"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test test/*.test.ts test/cli/*.test.ts test/skills/*.test.ts test/commands/*.test.ts"
  },
  "dependencies": {
    "@di/agent": "*",
    "@di/ai": "*",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
