          "usage": { "inputTokens": 0, "outputTokens": 0 },
          "cost": null,
          "model": "fake"
        }
      ]
    }
  },
  "expected": {
    "stopReason": "interrupted",
    "answer": "let me check",
    "iterations": 1,
    "usage": { "inputTokens": 0, "outputTokens": 0 },
    "cost": null,
    "failure": null,
    "modelRequestCount": 1,
    "eventSequence": ["turnCompleted", "interrupted"],
    "toolCalls": [],
    "trajectoryCount": 2,
    "trajectory": [
      { "role": "user", "content": [{ "type": "text", "text": "hello" }] },
      {
        "role": "assistant",
        "content": [
          { "type": "text", "text": "let me check" },
          { "type": "tool-call", "id": "c1", "name": "echo", "arguments": "{}" }
        ]
      }
