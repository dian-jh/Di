    "baseline": "09f4e0816c1b2dc42461e79a968b46e811d3880c",
    "tests": [
      "Di.Tests/AgentLoop/ReActInterruptTests.cs::StopRequested_AfterModelProducedToolCalls_DoesNotExecuteTools"
    ],
    "docs": "docs/migration/typescript-core/loop-and-state.md §中断、取消与并发生命周期; docs/modules/interrupt.md"
  },
  "input": {
    "sessionId": "soft-stop",
    "systemPrompt": "test system prompt",
    "userMessage": "hello",
    "history": [],
    "systemContext": null,
    "tools": [],
    "contextTokenBudget": null,
    "maxIterations": 8,
    "maxTokens": null,
    "reasoningEffort": null,
    "finalOutputTool": null,
    "interrupt": { "softStopAfterTurn": 1 },
    "model": {
      "responses": [
        {
          "text": "let me check",
          "toolCalls": [{ "id": "c1", "name": "echo", "arguments": "{}" }],
          "finishReason": "tool-calls",
