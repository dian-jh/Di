{
  "name": "di-typescript-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Di TypeScript Core migration workspace (root)",
  "engines": {
    "node": ">=22.19"
  },
  "workspaces": [
    "tui",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @di/ai && npm run build -w @di/agent && npm run build -w di-tui && npm run build -w @di/coding-agent",
    "test": "npm run build --workspaces --if-present && npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:compat": "node --test packages/coding-agent/test/compat/*.test.mjs packages/coding-agent/test/compat/*.test.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.5"
  }
}
